# Zkopírujte tento soubor jako ".env.local" a doplňte skutečné hodnoty.
# Hodnoty najdete v Supabase: Project Settings -> API.

# Veřejná URL vašeho Supabase projektu
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Veřejný "anon" klíč (bezpečný pro použití v prohlížeči)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# TAJNÝ "service_role" klíč - POUZE pro server (export API).
# NIKDY ho nedávejte do veřejného/klientského kódu ani ho nikam nesdílejte.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Vlastní dlouhý náhodný token pro zabezpečení exportu do Excelu.
# Vygenerujte si vlastní (např. příkazem: openssl rand -hex 32)
EXPORT_API_TOKEN=zmente-me-na-nahodny-dlouhy-retezec
